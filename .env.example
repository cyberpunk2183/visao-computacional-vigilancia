# Fluxo RTSP de cada DVR. O {} é substituído pelo número do canal.
# NUNCA versione os valores reais (usuário, senha e IP do DVR).
RTSP_BASE_LOJA1=rtsp://usuario:senha@192.0.2.21:554/cam/realmonitor?channel={}&subtype=1
CANAIS_LOJA1=32
RTSP_BASE_LOJA2=rtsp://usuario:senha@192.0.2.196:554/cam/realmonitor?channel={}&subtype=1
CANAIS_LOJA2=18
